@misc{aliyu2026interpolation,
  abbr={Preprint},
  title={Between Memorization and Generalization: An Interpolation Regime in Learning Dynamics},
  author={Aliyu, Mahi Aminu and Imran, Ahmad and Farid, Karim},
  year={2026},
  note={Preprint},
  pdf={Aliyu2026_interpolation_regime.pdf},
  bibtex_show={true},
  selected={true},
  abstract={Grokking marks the onset of generalization, but not how it unfolds. We study the structure of this transition by separating held-out problems according to whether they can be solved by interpolating from what the model has already seen. In the in-context modular-arithmetic setting of He et al. (2024), who identified two algorithms mechanistically in trained transformers, we follow both through training. Transformers first acquire Ratio Matching, which rescales a single in-context example. Only later, and only with enough context, do they acquire Modular Regression, which combines several examples and reaches beyond interpolation. Shallower models remain confined to Ratio Matching. We observe the same ordering in a controlled family of compositional tasks. Transformers first solve the held-out tasks that are recoverable as least-squares blends of training tasks, and solve the remaining tasks only later. The standard held-out threshold is crossed before this second transition, and MLPs of the same size rarely progress beyond interpolation. The ordering persists under controls for threshold choice and group size and, for MLPs, is not accounted for by task difficulty. More diverse training tasks shorten the interpolation window, whereas harder tasks stretch it. These results suggest that the transition from memorization to generalization is not a single global event, but a sequence of staggered capability transitions that aggregate evaluation collapses into one. We discuss whether this intermediate regime may contribute to plausible-but-incorrect predictions in larger models, including hallucinations.}
}

