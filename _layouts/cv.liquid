---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      {% if page.cv_pdf %}
        <a
          href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
          target="_blank"
          rel="noopener noreferrer"
          class="float-right"
          title="Download CV (PDF)"
          ><i class="fa-solid fa-file-pdf"></i
        ></a>
      {% endif %}
    </h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    {{ content }}
    {% if page.cv_pdf %}
      {% assign cv_url = page.cv_pdf | prepend: 'assets/pdf/' | relative_url %}
      <p>
        <a href="{{ cv_url }}" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-download"></i> Download CV (PDF)</a>
      </p>
      <object data="{{ cv_url }}" type="application/pdf" width="100%" style="height: 85vh; min-height: 600px">
        <p>
          Your browser can't display the PDF here.
          <a href="{{ cv_url }}" target="_blank" rel="noopener noreferrer">Open the CV</a> instead.
        </p>
      </object>
    {% endif %}
  </article>
</div>
